      "parameters": {
        "jsCode": "// Mapeia o valor pago -> plano/limites/travas.\n// Fonte unica de verdade: substitui os dois Switch duplicados do fluxo antigo.\nconst PLANOS = {\n  97: {\n    plano_nome: 'PLANO STARTER',\n    plano_id: '5cc6e8fe-3d5a-42a3-913a-3fb3db746ea9',\n    custom_max_instancias: 1,\n    custom_max_grupos_monitorar: 1,\n    custom_max_grupos_disparar: 5,\n    starter_lock: true,\n    inst_lock: true,\n    sitebio_lock: true,\n  },\n  167: {\n    plano_nome: 'PLANO PROFISSIONAL',\n    plano_id: '53e7c85d-7223-4fd7-a53b-53cfeb607d51',\n    custom_max_instancias: 1,\n    custom_max_grupos_monitorar: 2,\n    custom_max_grupos_disparar: 10,\n    starter_lock: false,\n    inst_lock: true,\n    sitebio_lock: false,\n  },\n  247: {\n    plano_nome: 'PLANO BUSINESS',\n    plano_id: '705137df-41bf-44ff-873a-01c995b1b1c9',\n    custom_max_instancias: 2,\n    custom_max_grupos_monitorar: 3,\n    custom_max_grupos_disparar: 20,\n    starter_lock: false,\n    inst_lock: false,\n    sitebio_lock: false,\n  },\n};\n\nconst dados = $('Normaliza dados').first().json;\nconst ctx = $input.first().json;\n\nconst valor = Number(dados.valor);\nconst plano = PLANOS[valor];\n\nif (!plano) {\n  // Falha explicita: melhor um erro visivel no n8n do que uma compra\n  // que passa batido sem provisionar nada.\n  throw new Error(\n    `Valor de plano nao reconhecido: \"${dados.valor}\". ` +\n    `Compra de ${dados.email} (usuario_id ${ctx.usuario_id}) NAO foi provisionada. ` +\n    `Valores aceitos: ${Object.keys(PLANOS).join(', ')}.`,\n  );\n}\n\nreturn [{\n  json: {\n    usuario_id: ctx.usuario_id,\n    novo: ctx.novo,\n    email: dados.email,\n    nome: dados.nome,\n    phone: dados.phone,\n    valor,\n    ...plano,\n  },\n}];\n"
      },
