    {
      "parameters": {
        "fromEmail": "noreply@redirectflow.com.br",
        "toEmail": "={{ $('Normaliza dados').first().json.email }}",
        "subject": "Bem-vindo (a) ao Redirect Flow - Seu acesso",
        "html": "=<!DOCTYPE html>\n<html lang=\"pt-BR\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Bem-vindo ao Redirect Flow</title>\n</head>\n<body style=\"margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; background-color: #f5f7fa;\">\n    <table role=\"presentation\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" width=\"100%\" style=\"background-color: #f5f7fa;\">\n        <tr>\n            <td style=\"padding: 40px 20px;\">\n                <table role=\"presentation\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" width=\"100%\" style=\"max-width: 600px; margin: 0 auto; background-color: #ffffff; border-radius: 12px; overflow: hidden; box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);\">\n\n                    <!-- Header branco com logo azul -->\n                    <tr>\n                        <td style=\"background-color: #ffffff; padding: 40px 30px; text-align: center; border-bottom: 1px solid #e2e8f0;\">\n                            <img src=\"https://rediirect.com/wp-content/uploads/2025/11/redirect-flowpreta.png\" alt=\"Redirect Flow\" style=\"max-width: 160px; height: auto; margin-bottom: 24px;\">\n                            <h1 style=\"color: #1a202c; font-size: 26px; font-weight: 600; margin: 0; line-height: 1.3;\">Bem-vindo ao Redirect Flow</h1>\n                            <p style=\"color: #718096; font-size: 15px; margin: 12px 0 0 0; line-height: 1.5;\">Sua conta está ativa e pronta para uso</p>\n                        </td>\n                    </tr>\n\n                    <!-- Conteudo -->\n                    <tr>\n                        <td style=\"padding: 40px 30px; background: linear-gradient(135deg, #4F7FFF 0%, #3D5FCC 100%);\">\n                            <p style=\"color: #ffffff; font-size: 15px; line-height: 1.7; margin: 0 0 28px 0;\">\n                                Seu acesso à plataforma Redirect Flow foi configurado com sucesso. Utilize as credenciais abaixo para fazer login e começar a gerenciar suas automações.\n                            </p>\n\n                            <!-- Box de credenciais -->\n                            <table role=\"presentation\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" width=\"100%\" style=\"background-color: rgba(255, 255, 255, 0.95); border-radius: 8px; margin-bottom: 28px;\">\n                                <tr>\n                                    <td style=\"padding: 28px;\">\n                                        <h2 style=\"color: #1a202c; font-size: 16px; font-weight: 600; margin: 0 0 20px 0; letter-spacing: -0.2px;\">Credenciais de Acesso</h2>\n\n                                        <table role=\"presentation\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" width=\"100%\">\n                                            <tr>\n                                                <td style=\"padding-bottom: 16px;\">\n                                                    <p style=\"color: #718096; font-size: 12px; font-weight: 500; text-transform: uppercase; letter-spacing: 0.8px; margin: 0 0 6px 0;\">E-mail</p>\n                                                    <p style=\"color: #1a202c; font-size: 15px; font-weight: 500; margin: 0;\">{{ $('Normaliza dados').first().json.email }}</p>\n                                                </td>\n                                            </tr>\n                                            <tr>\n                                                <td>\n                                                    <p style=\"color: #718096; font-size: 12px; font-weight: 500; text-transform: uppercase; letter-spacing: 0.8px; margin: 0 0 6px 0;\">Senha</p>\n                                                    <p style=\"color: #1a202c; font-size: 15px; font-weight: 600; margin: 0; font-family: 'Courier New', monospace; background-color: #f7fafc; padding: